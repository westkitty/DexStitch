{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DexStitch CharacterProfile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "measurements",
    "privacy"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": "string"
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observations",
        "resolved"
      ],
      "properties": {
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "valueMm",
              "source",
              "capturedAt"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "valueMm": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "source": {
                "enum": [
                  "manual",
                  "camera",
                  "lidar"
                ]
              },
              "capturedAt": {
                "type": "string",
                "format": "date-time"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "calibrationId": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              }
            }
          }
        },
        "resolved": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "valueMm",
              "observationIndices",
              "reviewedByUser"
            ],
            "properties": {
              "valueMm": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "observationIndices": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "reviewedByUser": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "required": [
        "retainRawImages",
        "cloudSyncEnabled"
      ],
      "properties": {
        "retainRawImages": {
          "type": "boolean",
          "default": false
        },
        "cloudSyncEnabled": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
